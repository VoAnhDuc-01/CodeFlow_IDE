        "end": "^\\s*\\/\\*\\s*#endregion\\b.*\\*\\/"
      }
    },
    "indentationRules": {
      "increaseIndentPattern": "(^.*\\{[^}]*$)",
      "decreaseIndentPattern": "^\\s*\\}"
    },
    "wordPattern": "(#?-?\\d*\\.\\d\\w*%?)|(::?[\\w-]*(?=[^,{;]*[,{]))|(([@#.!])?[\\w-?]+%?|[@#!.])"
